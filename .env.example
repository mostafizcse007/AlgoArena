# -----------------------------------------------------------------------------
# AlgoArena - Environment Variables Template
# Copy this file to .env.local for local development, or add these variables in
# your Vercel Project Settings (Project Settings -> Environment Variables).
# -----------------------------------------------------------------------------

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

